generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String                @id @default(cuid())
  email          String                @unique
  name           String
  passwordHash   String
  role           String                // "OWNER" | "RESPONDENT"
  department     String                @default("CPE")
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  sessions       Session[]
  ownedSurveys   Survey[]              @relation("SurveyOwner")
  participations SurveyParticipation[]
  responses      Response[]            @relation("RespondentResponses")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Survey {
  id               String                @id @default(cuid())
  ownerId          String
  title            String
  description      String?
  mode             String                @default("IDENTIFIED") // "IDENTIFIED" | "ANONYMOUS"
  status           String                @default("DRAFT")      // "DRAFT" | "PUBLISHED" | "CLOSED"
  targetDepartment String?
  closesAt         DateTime?
  publishedAt      DateTime?
  closedAt         DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  owner            User                  @relation("SurveyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  questions        Question[]
  participations   SurveyParticipation[]
  responses        Response[]

  @@index([ownerId])
  @@index([status])
}

model Question {
  id         String         @id @default(cuid())
  surveyId   String
  text       String
  type       String         // "SINGLE_CHOICE" | "RATING"
  required   Boolean        @default(true)
  orderIndex Int            @default(0)
  survey     Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options    ChoiceOption[]
  answers    Answer[]

  @@index([surveyId])
}

model ChoiceOption {
  id         String   @id @default(cuid())
  questionId String
  text       String
  orderIndex Int      @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@index([questionId])
}

model SurveyParticipation {
  id          String   @id @default(cuid())
  surveyId    String
  userId      String
  responseId  String?
  submittedAt DateTime @default(now())
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([surveyId, userId])
}

model Response {
  id           String   @id @default(cuid())
  surveyId     String
  respondentId String?  // NULL when survey.mode === "ANONYMOUS"
  submittedAt  DateTime @default(now())
  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondent   User?    @relation("RespondentResponses", fields: [respondentId], references: [id], onDelete: SetNull)
  answers      Answer[]

  @@index([surveyId])
  @@index([respondentId])
}

model Answer {
  id          String        @id @default(cuid())
  responseId  String
  questionId  String
  optionId    String?       // Nullable for RATING or unanswered optional question
  ratingValue Int?          // Nullable for SINGLE_CHOICE or unanswered optional question
  textValue   String?       // Reserved for SHORT_TEXT in Sprint 2
  response    Response      @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question    Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option      ChoiceOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([responseId, questionId])
}

