# ==============================================================================
# Pollipop Client (Vite / React) — Environment Configuration Template
# Copy to client/.env for local development overrides. NEVER commit secrets.
# ==============================================================================

# Local Vite dev-server proxy target for /api requests (used by client/vite.config.ts)
VITE_API_PROXY_TARGET="http://localhost:3000"

# Optional API base URL override for browser fetch requests (used by client/src/api.ts)
# Leave empty ("") in single-container / same-origin production deployments on Cloud Run
VITE_API_URL=""
