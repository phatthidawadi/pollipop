# Application Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Database Connection (Default: SQLite for local dev & testing)
# PostgreSQL connection for production / Lab 5 Cloud Run is provided as comment
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pollipop_db?schema=public"

# Session Secret (Minimum 32 random characters for signing/encryption)
SESSION_SECRET="change-this-to-a-secure-random-32-chars-string"

# Seed Accounts Default Password (For development & testing only)
DEMO_USER_PASSWORD="ChangeMeInDev123!"

