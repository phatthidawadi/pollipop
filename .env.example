# ==============================================================================
# Pollipop — Environment Configuration Template (Cloud-Ready / PostgreSQL)
# Copy this file to .env for local development. NEVER commit real secrets.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Allowed CORS Origins (comma-separated in production, or Vite dev server locally)
CORS_ORIGIN="http://localhost:5173"

# PostgreSQL Database Connection
# Local Docker Compose / Local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pollipop?schema=public"
# Production Google Cloud SQL (injected via Secret Manager: sda0ec11f-database-url):
# DATABASE_URL="postgresql://sda0ec11f:<PASSWORD>@localhost/sda0ec11f?host=/cloudsql/cpe-se-course-2026:asia-southeast1:sda0ec11f-pg"

# Session Cookie Secret (Production: injected via Secret Manager sda0ec11f-app-secret-1)
SESSION_SECRET="replace-with-a-secure-random-32-char-secret"

# Idempotent Seed Account Passwords (Production: injected via Secret Manager)
# sda0ec11f-admin-password / sda0ec11f-demo-password
ADMIN_PASSWORD="ChangeMeInDev123!"
DEMO_USER_PASSWORD="ChangeMeInDev123!"

# Set to "true" to seed sample university surveys and demo responses
SEED_DEMO_DATA=false
